# Server-side only. The browser never sees this key; all Gemini calls go through /api/ai.
# Leave it unset and the whole product still works — every AI touchpoint has a
# deterministic fallback, and no verdict depends on the model.
GEMINI_API_KEY=

# Optional. Soft spend ceiling in US dollars for a single session. Default 0.50.
# Public because the ledger that enforces it lives in the browser beside the cache.
NEXT_PUBLIC_AI_COST_CEILING_USD=0.50
